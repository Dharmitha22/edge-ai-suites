# Copy to .env and adjust as needed:  cp .env.example .env

# --- Build-time -------------------------------------------------------------
# Base URL the SPA calls. Empty => relative/same-origin (recommended for the
# baked-in app image).
VITE_API_BASE_URL=

# --- GPU/NPU passthrough (docker-compose.gpu.yml only) ----------------------
# Render group GID for /dev/dri access:
#   RENDER_GID=$(getent group render | cut -d: -f3)
RENDER_GID=

# --- Future model-downloader container --------------------------------------
# HuggingFace token (never bake into images). Leave empty if not needed.
HF_TOKEN=
# Model hub: huggingface | modelscope
MODEL_HUB=huggingface
