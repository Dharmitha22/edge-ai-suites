# Copy to .env and adjust as needed:  cp .env.example .env

# --- Build-time -------------------------------------------------------------
# Base URL the SPA calls. Empty => relative/same-origin (recommended for the
# baked-in app image).
VITE_API_BASE_URL=

# --- GPU/NPU passthrough (docker-compose.gpu.yml only) ----------------------
# Render group GID for /dev/dri access:
#   RENDER_GID=$(getent group render | cut -d: -f3)
RENDER_GID=

# --- metrics-collector sidecar (live Resource Utilization dashboard) --------
# Built locally from the vendored performance-tools/ submodule (live-metrics
# isn't in any published intel/retail-benchmark tag yet - see
# docker-compose.yml). Run `git submodule update --init` first.
# URL the app backend polls for /metrics and /platform-info (see
# monitoring/monitor.py). Default matches the docker-compose service name.
METRICS_COLLECTOR_URL=http://metrics-collector:9000

# --- Future model-downloader container --------------------------------------
# HuggingFace token (never bake into images). Leave empty if not needed.
HF_TOKEN=
# Model hub: huggingface | modelscope
MODEL_HUB=huggingface
